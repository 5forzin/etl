[Unit]
Description=ETL encrypted transport server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=etl
Group=etl
WorkingDirectory=/opt/etl
ExecStart=/usr/bin/node /opt/etl/src/cli.js server --port 443 --cert /etc/etl/fullchain.pem --key /etc/etl/privkey.pem --token-file /etc/etl/token
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
